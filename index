<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AP AKI CRRT 2026 - Word Cloud Poll</title>
    <style>
        :root {
            --bg-color: rgb(42, 62, 115);
            --text-color: #ffffff;
            --accent-color: #f75c96; /* Pink from your logo */
            --input-bg: rgba(255, 255, 255, 0.1);
        }
        
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            text-align: center;
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.2);
        }

        header img {
            max-width: 100%;
            height: auto;
            max-height: 100px;
        }

        main {
            flex: 1;
            padding: 20px;
            max-width: 700px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        .question-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            text-align: center;
        }

        h2 {
            font-size: 1.4rem;
            line-height: 1.4;
            margin-top: 0;
            margin-bottom: 25px;
        }

        input[type="text"] {
            width: 100%;
            padding: 15px;
            font-size: 1.2rem;
            background-color: var(--input-bg);
            border: 2px solid rgba(255,255,255,0.2);
            color: white;
            border-radius: 8px;
            box-sizing: border-box;
            text-align: center;
            outline: none;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus {
            border-color: var(--accent-color);
        }

        button {
            width: 100%;
            padding: 15px;
            margin-top: 20px;
            background-color: var(--accent-color);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #d84a7d;
        }
        
        button:disabled {
            background-color: #888;
            cursor: not-allowed;
        }

        /* Results & Word Cloud Section */
        #resultsSection {
            display: none;
        }

        #wordCloudContainer {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 15px;
            padding: 20px 0;
            min-height: 200px;
        }

        .cloud-word {
            display: inline-block;
            font-weight: bold;
            line-height: 1;
            transition: transform 0.3s ease, color 0.3s ease;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
        }

        .cloud-word:hover {
            transform: scale(1.1);
        }

        .total-votes {
            margin-top: 30px;
            font-size: 1.1rem;
            color: rgba(255,255,255,0.7);
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 20px;
        }

        footer {
            text-align: center;
            padding: 15px;
            font-size: 0.8rem;
            background-color: rgba(0, 0, 0, 0.3);
            color: rgba(255, 255, 255, 0.7);
        }
    </style>
</head>
<body>

    <header>
        <img src="logo_AP_AKI_CRRT_2026.png" alt="AP AKI CRRT 2026 Logo">
    </header>

    <main>
        <div class="question-card" id="pollSection">
            <h2>Q: If you had to describe CRRT in just ONE word, what would it be?</h2>
            <form id="pollForm">
                <input type="text" id="wordInput" placeholder="Type your word here..." required maxlength="25" autocomplete="off">
                <button type="submit" id="submitBtn">Submit Word</button>
            </form>
        </div>

        <div class="question-card" id="resultsSection">
            <h2>Live Word Cloud</h2>
            
            <div id="wordCloudContainer"></div>

            <div class="total-votes">Total Submissions: <span id="totalVotes">0</span></div>
            
            <button id="voteAgainBtn">Submit Another Word</button>
        </div>
    </main>

    <footer>
        Copyright: AP AKI CRRT 2026. CC-BY-NC.
    </footer>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getFirestore, collection, doc, setDoc, increment, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

        const firebaseConfig = {
          apiKey: "AIzaSyCKlfwQgW0VHHYLXKjHa4NxHqmvvvXdbeU",
          authDomain: "crrt-wordcloudv0.firebaseapp.com",
          databaseURL: "https://crrt-wordcloudv0-default-rtdb.asia-southeast1.firebasedatabase.app",
          projectId: "crrt-wordcloudv0",
          storageBucket: "crrt-wordcloudv0.firebasestorage.app",
          messagingSenderId: "36164467422",
          appId: "1:36164467422:web:0b0f4153ba93a96cf7a04f",
          measurementId: "G-W21J2R1D8T"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        
        // We will store words in a subcollection called 'wordcloud_q1'
        const wordsCollectionRef = collection(db, "wordcloud_q1");

        // DOM Elements
        const pollSection = document.getElementById('pollSection');
        const resultsSection = document.getElementById('resultsSection');
        const pollForm = document.getElementById('pollForm');
        const submitBtn = document.getElementById('submitBtn');
        const voteAgainBtn = document.getElementById('voteAgainBtn');
        const wordInput = document.getElementById('wordInput');
        const wordCloudContainer = document.getElementById('wordCloudContainer');
        const totalVotesSpan = document.getElementById('totalVotes');

        // Color palette for the Word Cloud (fitting the Gala theme)
        const colors = ['#f75c96', '#4cc9f0', '#43aa8b', '#f9c74f', '#ffffff', '#a0c4ff'];

        // Handle Form Submission
        pollForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const rawWord = wordInput.value.trim();
            if (!rawWord) return;

            submitBtn.disabled = true;
            submitBtn.innerText = "Submitting...";

            // Normalize the word so "Life-saving", "life-saving", and "LIFE-SAVING" count as the same thing
            const normalizedID = rawWord.toLowerCase();
            
            // Reference a specific document for this word
            const wordDocRef = doc(db, "wordcloud_q1", normalizedID);

            try {
                // setDoc with merge: true will create the document if it doesn't exist, or update it if it does
                await setDoc(wordDocRef, {
                    display: rawWord, // Store the original casing (e.g., "Complex")
                    count: increment(1)
                }, { merge: true });
                
                // Transition to results
                pollSection.style.display = 'none';
                resultsSection.style.display = 'block';
                pollForm.reset();
            } catch (error) {
                console.error("Error writing to database: ", error);
                alert("An error occurred. Check your database rules and configuration.");
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = "Submit Word";
            }
        });

        // Handle 'Submit Another Word'
        voteAgainBtn.addEventListener('click', () => {
            resultsSection.style.display = 'none';
            pollSection.style.display = 'block';
            setTimeout(() => wordInput.focus(), 100);
        });

        // Real-time listener for the Word Cloud
        onSnapshot(wordsCollectionRef, (snapshot) => {
            let totalSubmissions = 0;
            let wordsData = [];

            snapshot.forEach((doc) => {
                const data = doc.data();
                wordsData.push(data);
                totalSubmissions += data.count;
            });

            totalVotesSpan.innerText = totalSubmissions;
            renderWordCloud(wordsData);
        });

        // Function to draw the Word Cloud
        function renderWordCloud(wordsData) {
            wordCloudContainer.innerHTML = ''; // Clear current cloud

            if (wordsData.length === 0) {
                wordCloudContainer.innerHTML = '<span style="color:#aaa;">Waiting for words...</span>';
                return;
            }

            // Find the highest and lowest count to scale fonts properly
            const maxCount = Math.max(...wordsData.map(w => w.count));
            const minCount = Math.min(...wordsData.map(w => w.count));

            // Shuffle the array so the cloud looks random and organic
            wordsData.sort(() => Math.random() - 0.5);

            wordsData.forEach((wordObj, index) => {
                const span = document.createElement('span');
                span.classList.add('cloud-word');
                span.innerText = wordObj.display;

                // Calculate Font Size (Scale between 1.2rem and 4rem)
                let scale = maxCount === minCount ? 0.5 : (wordObj.count - minCount) / (maxCount - minCount);
                let fontSize = 1.2 + (scale * 2.8);
                span.style.fontSize = `${fontSize}rem`;

                // Assign a consistent color based on the word itself (so colors don't flicker on refresh)
                const colorIndex = wordObj.display.length % colors.length;
                span.style.color = colors[colorIndex];

                wordCloudContainer.appendChild(span);
            });
        }
    </script>
</body>
</html>
